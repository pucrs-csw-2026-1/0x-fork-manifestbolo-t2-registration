# DATABASE_URL deve vir do output "database_url" do módulo Terraform em
# app/infra/terraform/rds/ (terraform output -raw database_url), que provisiona
# o RDS Postgres na Ministack compartilhada externa a este repositório.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@<rds-endpoint>:5432/app_db

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://host.docker.internal:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

APP_NAME=App
APP_VERSION=0.1.0
DEBUG=true

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_SERVICE_BASE_URL=http://host.docker.internal:8080
EVENTS_SERVICE_BASE_URL=http://host.docker.internal:3000

SNS_REGISTRATION_TOPIC_NAME=registration-events
